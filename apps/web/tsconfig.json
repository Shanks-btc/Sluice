{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "noEmit": true,
    "declaration": false,
    "allowJs": false,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@sluice/sdk": [
        "../../packages/sdk/src/index.ts"
      ],
      "@sluice/sdk/*": [
        "../../packages/sdk/src/*"
      ],
      "@sluice/paid-tools/*": [
        "../../examples/paid-tools/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "snippets",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
