{
  "name": "sluice",
  "version": "0.1.0",
  "private": true,
  "description": "Pay-per-use for AI tools and APIs on QIE, settled in QUSDC",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "compile": "hardhat compile",
    "build": "tsc -p packages/sdk && tsc -p packages/facilitator && tsc -p packages/proxy && tsc -p packages/wallet-mcp && tsc -p examples/paid-tools",
    "typecheck": "pnpm web:content && tsc --noEmit && tsc -p apps/web --noEmit",
    "test": "hardhat test",
    "test:fork": "cross-env FORK=1 hardhat test",
    "gas:report": "cross-env FORK=1 GAS_REPORT=1 hardhat test",
    "evidence:check": "ts-node scripts/evidence-check.ts",
    "evidence:summary": "ts-node scripts/evidence-summary.ts",
    "mutation:check": "ts-node scripts/mutation-check.ts",
    "start:facilitator": "node packages/facilitator/dist/cli.js",
    "start:proxy": "node packages/proxy/dist/cli.js",
    "start:wallet": "node packages/wallet-mcp/dist/cli.js",
    "start:paid-tools": "node examples/paid-tools/dist/cli.js",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm web:build && pnpm test",
    "spec:vectors": "ts-node -r tsconfig-paths/register scripts/spec-vectors.ts",
    "web:content": "ts-node -r tsconfig-paths/register scripts/web-content.ts",
    "web:build": "pnpm --filter @sluice/web run build",
    "web:dev": "pnpm --filter @sluice/web run dev",
    "web:e2e": "hardhat run scripts/web-e2e.ts --no-compile",
    "web:shots": "hardhat run scripts/web-shots.ts --no-compile",
    "lint": "eslint apps/web test/unit/web test/helpers/mock-wallet.ts test/helpers/web-copy.ts test/fork/web.fork.test.ts scripts/web-content.ts scripts/web-e2e.ts scripts/web-shots.ts src/web-content.ts",
    "mutation:web": "ts-node -r tsconfig-paths/register scripts/mutation-web.ts",
    "web:start": "pnpm --filter @sluice/web run start",
    "evidence:record": "ts-node scripts/evidence/record.ts",
    "live:preflight": "ts-node scripts/live/preflight.ts",
    "live:facts": "ts-node scripts/live/facts.ts",
    "live:funding": "ts-node scripts/live/funding.ts",
    "live:golive:plan": "ts-node scripts/live/golive-plan.ts",
    "live:hostcheck": "ts-node scripts/live/hostcheck.ts",
    "live:vaultcheck": "ts-node scripts/live/vaultcheck.ts",
    "live:wire": "ts-node scripts/live/wire.ts",
    "mainnet:dryrun": "cross-env FORK=1 hardhat run scripts/mainnet-dryrun.ts --no-compile",
    "live:verify": "ts-node scripts/live/verify-contracts.ts",
    "live:test-token": "ts-node scripts/live/deploy-test-token.ts",
    "live:new-key": "ts-node scripts/live/new-key.ts",
    "client:smoke": "ts-node -r tsconfig-paths/register scripts/client/smoke-client.ts",
    "client:owner": "ts-node -r tsconfig-paths/register scripts/client/owner-setup.ts",
    "client:call": "ts-node -r tsconfig-paths/register scripts/client/paid-call.ts",
    "live:balances": "ts-node -r tsconfig-paths/register scripts/live/balances.ts",
    "mutation:live": "ts-node -r tsconfig-paths/register scripts/mutation-live.ts",
    "rehearsal:testnet": "ts-node -r tsconfig-paths/register scripts/rehearsal/testnet.ts"
  },
  "dependencies": {
    "ethers": "6.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.2",
    "@nomicfoundation/hardhat-ethers": "3.0.5",
    "@nomicfoundation/hardhat-network-helpers": "1.0.10",
    "@types/chai": "4.3.11",
    "@types/mocha": "10.0.6",
    "@types/node": "22.10.2",
    "chai": "4.3.10",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "hardhat": "2.17.4",
    "playwright-core": "1.64.1",
    "solc": "0.8.24",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.3.3",
    "typescript-eslint": "8.73.0",
    "zod": "3.25.76"
  }
}
