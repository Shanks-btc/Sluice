{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "declaration": false,
    "paths": {
      "@sluice/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@sluice/facilitator": [
        "packages/facilitator/src/index.ts"
      ],
      "@sluice/proxy": [
        "packages/proxy/src/index.ts"
      ],
      "@sluice/wallet-mcp": [
        "packages/wallet-mcp/src/index.ts"
      ],
      "@sluice/paid-tools": [
        "examples/paid-tools/src/index.ts"
      ],
      "@sluice/sdk/*": [
        "packages/sdk/src/*"
      ],
      "@sluice/paid-tools/*": [
        "examples/paid-tools/src/*"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "src",
    "scripts",
    "test",
    "packages/*/src",
    "examples/*/src",
    "apps/web/src/lib",
    "apps/web/src/status.ts",
    "apps/web/src/design",
    "apps/web/src/content",
    "apps/web/src/components",
    "apps/web/test-support"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "cache",
    "dist",
    "packages/*/dist",
    "examples/*/dist",
    "apps/web/.next"
  ]
}
