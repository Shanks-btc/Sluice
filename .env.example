# Names only. Never put a value in this file, and never commit a real .env.

# Which chain a program talks to: mainnet (chain 1990) or testnet (chain 1983). The facilitator also accepts local, for a local node.
SLUICE_NETWORK=
# RPC endpoint. Optional. With no value, a program probes QIE's five public endpoints for the chosen network, asks each for its chain id, uses the earliest in the list that answers with the right one and keeps the others as fallbacks for reads. A value here is used as given and is not probed. Required for the facilitator on a local node. Used by the live scripts, the facilitator, the paid tools and the wallet MCP.
SLUICE_RPC_URL=
# Secret. The signing key a live script uses. Never printed, never logged.
SLUICE_KEY=
# The program a person has approved, by name: deploy, smoke, facilitator, owner-setup or paid-call. A program refuses to run unless this equals its own name.
SLUICE_APPROVE=
# Spend caps per script. Optional; the defaults are 10 QUSDC and 5 QIE. Values above 100 QUSDC or 50 QIE are refused. For the facilitator, SLUICE_MAX_QIE is the relayer's daily QIE budget, required against mainnet or testnet, with a ceiling of 2 QIE.
SLUICE_MAX_QUSDC=
SLUICE_MAX_QIE=
# Optional cap on the QIE one transaction could cost (gas limit times gas price). A script stops before sending a transaction that could cost more. It may not be above SLUICE_MAX_QIE. The testnet rehearsal sets it to 0.05.
SLUICE_MAX_TX_QIE=
# The token the router will hold. Required on testnet. On mainnet leave it empty (it is QUSDC); any other value is refused.
SLUICE_TOKEN=
# The router owner (use a multisig) and the address that receives the fee.
SLUICE_OWNER=
SLUICE_FEE_RECIPIENT=
# The fee in basis points. The contract's hard cap is 200. Left empty, the deploy uses 100 (1%).
SLUICE_FEE_BPS=
# The relayer's public address (not its key). The deploy checks it is neither the owner nor the fee recipient, and neither is the deployer
# key's own address. Required on mainnet; or pass it as --relayer. Elsewhere it is checked when it is given.
SLUICE_RELAYER=
# The deployed router: smoke.ts tests it, and the facilitator, the paid tools and the summary use it.
SLUICE_ROUTER=
# The address that is paid. For the example paid tools, the builder's address. For smoke.ts it is optional: a different address to pay (default: the signer itself, so it can withdraw).
SLUICE_PAYEE=
# Secret. The facilitator's relayer key. It holds QIE for gas only. Never printed, never logged, never the router's owner or fee recipient.
SLUICE_RELAYER_KEY=
# The facilitator: the port it listens on (default 8402), where it is reached (the paid tools use this to find it), and the file that keeps its queue across restarts (required against mainnet or testnet, optional on a local node).
SLUICE_FACILITATOR_PORT=
SLUICE_FACILITATOR_URL=
SLUICE_FACILITATOR_STATE=
# The facilitator's address to listen on (default 127.0.0.1; a container sets 0.0.0.0 and a proxy in front adds TLS), and how many proxies in front of it append to X-Forwarded-For (default 0: the header is not believed).
SLUICE_FACILITATOR_HOST=
SLUICE_FACILITATOR_TRUST_PROXY_HOPS=
# The facilitator's kill switch: 1 stops relaying, settling and top-ups from the start; a file path is checked on every request, so creating the file stops it at once and deleting the file lets it go on. Reads keep working. Empty means off.
SLUICE_FACILITATOR_KILL_SWITCH=
SLUICE_FACILITATOR_KILL_FILE=
# The facilitator's limits on callers: the largest request body in bytes (default 65536, at most 1048576), and requests per minute from one client address (default 240) and per payer address (default 60).
SLUICE_FACILITATOR_MAX_BODY_BYTES=
SLUICE_FACILITATOR_RATE_LIMIT_IP=
SLUICE_FACILITATOR_RATE_LIMIT_PAYER=
# The facilitator's caps on its own QIE, in QIE: one top-up (default 0.001, ceiling 0.0015), and all top-ups to one address in a UTC day (default 0.001, ceiling 0.003). The relayer's low-balance flag in /health (default: one day's budget).
SLUICE_FACILITATOR_MAX_TOPUP_QIE=
SLUICE_FACILITATOR_MAX_TOPUP_PER_ADDRESS_QIE=
SLUICE_FACILITATOR_LOW_BALANCE_QIE=
# The facilitator's caps on QUSDC, in QUSDC, which can only be lowered: one zero-QIE start (default 10), what one payer may queue in a UTC day (default 50), and what all payers may queue in a UTC day (default 500). A value above the default stops the start.
SLUICE_FACILITATOR_MAX_ONBOARD_QUSDC=
SLUICE_FACILITATOR_PAYER_DAILY_QUSDC=
SLUICE_FACILITATOR_DAILY_QUSDC=
# The facilitator's timing and logs: how long a shutdown waits for a batch in progress (milliseconds, default 30000), how often queued intents are batched (default 15000), and the log level (debug, info, warn or error; default info).
SLUICE_FACILITATOR_SHUTDOWN_MS=
SLUICE_FACILITATOR_FLUSH_MS=
SLUICE_FACILITATOR_LOG_LEVEL=
# The facilitator's limit on one request to the node, in milliseconds (default 20000, from 1000 to 120000).
SLUICE_FACILITATOR_RPC_TIMEOUT_MS=
# The hosted tool server (examples/paid-tools, started with --http): its price table (token_risk_check=0.01,dex_quote=0.002,contract_lookup=0.005 is the default), the address and port it listens on (default 127.0.0.1 and 8403), and how many proxies in front append to X-Forwarded-For (default 0).
SLUICE_TOOLS_PRICES=
SLUICE_TOOLS_HOST=
SLUICE_TOOLS_PORT=
SLUICE_TOOLS_TRUST_PROXY_HOPS=
# The hosted tool server's limits: the largest request body in bytes (default 32768, at most 1048576), requests per minute from one address (default 300) and the part of them that carry no payment (default 60), the time one read from the node or the explorer may take in milliseconds (default 10000), and the log level.
SLUICE_TOOLS_MAX_BODY_BYTES=
SLUICE_TOOLS_RATE_LIMIT_IP=
SLUICE_TOOLS_RATE_LIMIT_UNPAID=
SLUICE_TOOLS_RPC_TIMEOUT_MS=
SLUICE_TOOLS_LOG_LEVEL=
# Secret. The agent's session key, for the payment proxy and the wallet MCP. Never the owner's key: both refuse to start with it. (The config file can name a different variable.)
SLUICE_AGENT_KEY=
# The proxy's and the wallet MCP's config file, if --config is not given on the command line.
SLUICE_CONFIG=
# The explorer's read API for the paid tools. Optional; defaults to the public QIE explorer.
SLUICE_EXPLORER_URL=
# pnpm evidence:summary: the block the router was deployed at, where counting starts.
SLUICE_FROM_BLOCK=
# RPC used by pnpm evidence:check and pnpm evidence:summary. Optional; defaults to the public QIE RPC for each section.
EVIDENCE_RPC_URL=
# Turns on the mainnet fork for pnpm test:fork (set by the script), and pins its block. Optional.
FORK=
FORK_BLOCK=
SLUICE_FORK_RPC_URL=
# Used by a docs test to count tests without running them: a file path the test runner writes its totals to. Leave empty.
SLUICE_COUNT_FILE=
# Used with the line above to pick which test folder to count (test/unit or test/fork). Leave empty.
SLUICE_TEST_DIR=
# Set to 1 by pnpm gas:report so the fork gas test writes docs/GAS.md. Leave empty otherwise.
GAS_REPORT=
# Cost basis for docs/GAS.md. Optional; the defaults are written into the report.
GAS_PRICE_WEI=
QIE_PRICE_USD=
# The facilitator's browser access: exact origins (https, or http on this machine, no path) that may call it from a web page, separated by commas. Empty means no web page may read its answers. Never a wildcard.
SLUICE_FACILITATOR_CORS_ORIGINS=
# Secret. The bearer token for the facilitator's private metrics path (GET /internal/metrics), 24 to 200 characters. With none set, the path does not exist. Never printed.
SLUICE_FACILITATOR_METRICS_TOKEN=
# Secret. Serverless only (the facilitator as a Vercel function): the bearer token the scheduled sweeper sends to /internal/drain, 24 to 200 characters. The function refuses to start without it. Never printed.
SLUICE_FACILITATOR_SWEEP_SECRET=
# Serverless only (the facilitator and the tool server as Vercel functions): the https address and the token of the Upstash Redis database that holds what the copies share. The token is a secret. Left empty, the names a marketplace integration may add are read instead (UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN, or KV_REST_API_URL and KV_REST_API_TOKEN).
SLUICE_REDIS_REST_URL=
SLUICE_REDIS_REST_TOKEN=
# Serverless only (the facilitator on Vercel): set to exactly one-token-for-both-services to let the facilitator use a database that the tool server also uses. Without it the facilitator refuses such a database. Both services then hold one token, so a fault in the tool server could reach the facilitator's data; a database for each is the stronger setup.
SLUICE_FACILITATOR_SHARED_DATABASE=
# The tool server's browser access: exact origins (https, or http on this machine, no path) that may call it from a web page, separated by commas. Empty means no web page may read its answers. Never a wildcard.
SLUICE_TOOLS_CORS_ORIGINS=
# Secret. The bearer token for the tool server's private metrics path (GET /internal/metrics), 24 to 200 characters. With none set, the path does not exist. Never printed.
SLUICE_TOOLS_METRICS_TOKEN=
# The web app (apps/web). Every NEXT_PUBLIC_ name reaches the browser, so none of them is ever a secret. The router and vault the pages read, the chain id (default 1990), and the RPC the pages read through (default: QIE's public RPC for the chain id; a local address makes the app say "local, no real funds").
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
# The web app: the facilitator it offers for a wallet with no QIE, the block the router was deployed at (where a scan for events can stop), the project's GitHub address (the footer and the documents link to it only when set), and the address the site is served from (for link previews).
NEXT_PUBLIC_FACILITATOR_URL=
# The web app: the hosted tool server the live demo and the builder's test call pay (it must list this site's origin in SLUICE_TOOLS_CORS_ORIGINS), and the most QUSDC the live pages will let one session deposit (default 1, never above 10).
NEXT_PUBLIC_TOOLS_URL=
NEXT_PUBLIC_SESSION_CAP_QUSDC=
NEXT_PUBLIC_FROM_BLOCK=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_SITE_URL=
# Set to 1 with pnpm test:fork to let test/fork/web.fork.test.ts write apps/web/src/content/fork-sample.json. Leave empty otherwise.
WRITE_FORK_SAMPLE=
